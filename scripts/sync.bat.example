:: Copy this to sync.bat and fill in your paths.
:: sync.bat is gitignored — never committed.

@echo off
set SRC=D:\Your\Project\Path
set DST=D:\World of Warcraft\_retail_\Interface\AddOns\YourAddon

robocopy "%SRC%" "%DST%" /MIR /XD .git .github .reasonix .claude .release /XF .gitignore .pkgmeta CLAUDE.md CHANGELOG.md release.sh /NFL /NDL /NP
if errorlevel 8 exit /b %errorlevel%
exit /b 0
